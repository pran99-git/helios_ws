<?xml version="1.0"?>
<!--
  Sensor mount frames: ZED 2i camera and Hokuyo UST-10LX LiDAR.

  Frame convention REP-103: x forward, y left, z up. base_link at the rover
  geometric center, at wheel-axle height. The ZED wrapper's root camera frame
  is zed_camera_link, which is attached to the rover via a fixed joint. The
  Hokuyo's frame is named 'laser' to match urg_node2's frame_id, so /scan lands here. Both sensors mount on the top surface of the chassis box.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


  <!-- ===================== ZED 2i ===================== -->
  <!-- 'zed_camera_link' is the ZED wrapper's root camera frame. This joint
       attaches it to the rover. 
       NOTE: make sure the ZED wrapper is NOT also publishing a base_link -> zed_camera_link transform 
       (otherwise the frame gets two parents). In the wrapper config set publish_tf so it only
       publishes the camera's *internal* frames, and let this URDF own the mount. -->
  <link name="zed_camera_link">
    <visual>
      <!-- ZED2i.STL has its own native axis convention (not the shared
           mesh_rpy). Raw mesh's widest axis (175mm, lens-to-lens span) needs
           to land on robot_y (left/right), not robot_x (forward) - this yaw
           does that. xyz recentered for this rotation (see mesh bbox). -->
      <origin xyz="0.01547 -0.08888 -0.02128" rpy="0 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://helios_description/meshes/ZED2i.STL" scale="${mesh_scale}"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.17525 0.030"/>   <!-- ZED 2i ~175 mm wide -->
      </geometry>
    </collision>
  </link>
  <joint name="zed_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_camera_link"/>
    <!-- Placeholder: top plate, leading edge, centerline. -->
    <origin xyz="0.101 0.0 0.050" rpy="0 0 0"/> 
  </joint>

  <!-- ===================== Hokuyo UST-10LX ===================== -->
  <!-- Frame name 'laser' matches urg_node2's frame_id, so /scan lands here. -->
  <link name="laser">
    <visual>
      <origin xyz="-0.03163 -0.02500 -0.03500" rpy="${mesh_rpy}"/>
      <geometry>
        <mesh filename="package://helios_description/meshes/Hokuyo-UST-10LX-Lidar.STL" scale="${mesh_scale}"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.020" length="0.0685"/>   <!-- UST-10LX ~50 mm dia -->
      </geometry>
    </collision>
  </link>
  <joint name="laser_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <!-- Placeholder: top plate, aft of the ZED. -->
    <origin xyz="0.045 0 0.100" rpy="0 0 0"/>
  </joint>

</robot>
