<?xml version="1.0"?>
<!--
  Helios rover (Lynxmotion A4WD3 Mecanum) — top-level xacro.
  Composes common.xacro (shared properties + materials),
  base.xacro (chassis + wheels) and sensors.xacro (ZED + LiDAR mount frames).

  common.xacro MUST come first — the other two consume its properties and
  materials. base.xacro and sensors.xacro are independent of each other and
  may be listed in either order.
-->
<robot name="helios" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find helios_description)/urdf/common.xacro"/>
  <xacro:include filename="$(find helios_description)/urdf/base.xacro"/>
  <xacro:include filename="$(find helios_description)/urdf/sensors.xacro"/>

</robot>
