<?xml version="1.0"?>
<!--
  Base: chassis + 4 mecanum wheels. All dimensions from the verified rover
  geometry (see wheel_odometry). Frame convention REP-103: x forward, y left,
  z up. base_link at the rover geometric center, at wheel-axle height.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Parameters ===================== -->
  <xacro:property name="wheel_radius"   value="0.076"/>   <!-- 152 mm dia -->
  <xacro:property name="wheel_width"    value="0.045"/>   <!-- rough -->
  <xacro:property name="half_wheelbase" value="0.110"/>   <!-- wheelbase 0.220 / 2 (front<->rear) -->
  <xacro:property name="half_track"     value="0.165"/>   <!-- track 0.330 / 2 (left<->right) -->

  <!-- Chassis collision box (rough; A4WD3 frame ~ 0.32 x 0.24 x 0.10). -->
  <xacro:property name="chassis_length" value="0.320"/>
  <xacro:property name="chassis_width"  value="0.240"/>
  <xacro:property name="chassis_height" value="0.0785"/>

  <!-- CAD meshes (meshes/*.STL) were exported in millimeters with a Y-up,Z-forward convention        
      zed bounding boxes: mesh_y -> robot up, mesh_z -> robot forward,
       mesh_x -> robot left). mesh_scale converts mm -> m; mesh_rpy is the
       fixed rotation that maps the CAD frame into REP-103 (x fwd, y left,
       z up). mesh_*_xyz below re-center each mesh's bounding-box centroid on
       its link origin.
       -->
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>
  <xacro:property name="mesh_rpy"   value="${pi/2} 0 ${pi/2}"/>
  <xacro:property name="chassis_mesh_xyz" value="-0.16552 -0.13383 -0.03827"/>
  <xacro:property name="wheelA_mesh_xyz"  value="-0.08398 -0.02833 -0.08436"/>
  <xacro:property name="wheelB_mesh_xyz"  value="-0.08395 -0.02833 -0.08436"/>

  <!-- ===================== Materials ===================== -->
  <material name="chassis_grey"><color rgba="0.30 0.32 0.35 1.0"/></material>
  <material name="wheel_black"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="sensor_blue"><color rgba="0.10 0.30 0.80 1.0"/></material>

  <!-- ===================== base_link (root) ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="${chassis_mesh_xyz}" rpy="${mesh_rpy}"/>
      <geometry>
        <mesh filename="package://helios_description/meshes/Rover-Chassis.STL" scale="${mesh_scale}"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- base_link_inertia: KDL doesn't support inertia on the root link, so the
       chassis mass lives here instead (fixed, identity offset from base_link)
       rather than on base_link itself. -->
  <link name="base_link_inertia">
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.10"/>
    </inertial>
  </link>
  <joint name="base_link_inertia_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- base_footprint: ground projection below base_link (child, so base_link
       keeps a single parent = odom from the odometry node). -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 ${-wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Wheel macro ===================== -->
  <!-- mesh_file/mesh_xyz select one of the two A4WD3 mecanum wheel meshes.
       Mecanum wheels are handed: rollers on diagonal corners mirror each
       other so the X-roller pattern lets the drivetrain strafe.-->
  <xacro:macro name="wheel" params="name x y mesh_file mesh_xyz">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="${mesh_xyz}" rpy="${mesh_rpy}"/>
        <geometry>
          <mesh filename="package://helios_description/meshes/${mesh_file}" scale="${mesh_scale}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Corner names match the wheel_odometry node. -->
  <xacro:wheel name="front_left"  x="${half_wheelbase}"  y="${half_track}"
               mesh_file="A4WD3-W-ME-B.STL" mesh_xyz="${wheelA_mesh_xyz}"/>
  <xacro:wheel name="front_right" x="${half_wheelbase}"  y="${-half_track}"
               mesh_file="A4WD3-W-ME-A.STL" mesh_xyz="${wheelB_mesh_xyz}"/>
  <xacro:wheel name="rear_left"   x="${-half_wheelbase}" y="${half_track}"
               mesh_file="A4WD3-W-ME-A.STL" mesh_xyz="${wheelB_mesh_xyz}"/>
  <xacro:wheel name="rear_right"  x="${-half_wheelbase}" y="${-half_track}"
               mesh_file="A4WD3-W-ME-B.STL" mesh_xyz="${wheelA_mesh_xyz}"/>

</robot>
