<?xml version="1.0"?>
<!--
  Base: chassis + 4 mecanum wheels. All dimensions from the verified rover
  geometry (see wheel_odometry). Frame convention REP-103: x forward, y left,
  z up. base_link at the rover geometric center, at wheel-axle height.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Parameters ===================== -->
  <xacro:property name="wheel_radius"   value="0.076"/>   <!-- 152 mm dia -->
  <xacro:property name="wheel_width"    value="0.045"/>   <!-- rough -->
  <xacro:property name="half_wheelbase" value="0.110"/>   <!-- wheelbase 0.220 / 2 (front<->rear) -->
  <xacro:property name="half_track"     value="0.165"/>   <!-- track 0.330 / 2 (left<->right) -->

  <!-- Chassis body box (rough; A4WD3 frame ~ 0.32 x 0.24 x 0.10). -->
  <xacro:property name="chassis_length" value="0.320"/>
  <xacro:property name="chassis_width"  value="0.240"/>
  <xacro:property name="chassis_height" value="0.0785"/>

  <!-- ===================== Materials ===================== -->
  <material name="chassis_grey"><color rgba="0.30 0.32 0.35 1.0"/></material>
  <material name="wheel_black"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="sensor_blue"><color rgba="0.10 0.30 0.80 1.0"/></material>

  <!-- ===================== base_link (root) ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.10"/>
    </inertial>
  </link>

  <!-- base_footprint: ground projection below base_link (child, so base_link
       keeps a single parent = odom from the odometry node). -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 ${-wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Wheel macro ===================== -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Corner names match the wheel_odometry node. -->
  <xacro:wheel name="front_left"  x="${half_wheelbase}"  y="${half_track}"/>
  <xacro:wheel name="front_right" x="${half_wheelbase}"  y="${-half_track}"/>
  <xacro:wheel name="rear_left"   x="${-half_wheelbase}" y="${half_track}"/>
  <xacro:wheel name="rear_right"  x="${-half_wheelbase}" y="${-half_track}"/>

</robot>
