<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sensor_fusion</name>
  <version>0.1.0</version>
  <description>
    Sensor fusion for the Helios A4WD3 mecanum rover. A robot_localization EKF
    fuses wheel odometry with the ZED 2i visual-inertial odometry (camera + IMU)
    to produce a smooth odom -> base_link, and slam_toolbox uses the Hokuyo
    LiDAR to provide map -> odom. Follows REP-105.
  </description>
  <maintainer email="upadhyp1@uci.edu">pran</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- Bring-up includes these workspace packages -->
  <exec_depend>helios_description</exec_depend>
  <exec_depend>wheel_odometry</exec_depend>
  <exec_depend>zed_wrapper</exec_depend>
  <exec_depend>urg_node2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
