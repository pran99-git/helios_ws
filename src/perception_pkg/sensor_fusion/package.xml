<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sensor_fusion</name>
  <version>0.1.0</version>
  <description>
    Sensor bring-up and fusion for the Helios A4WD3 mecanum rover. Starts every
    sensor driver and fuses their output: a robot_localization EKF combines
    wheel odometry with the ZED 2i visual-inertial odometry (camera + IMU) to
    produce a smooth odom -> base_link plus /odometry/filtered.

    This is the perception layer and it stops there -- map -> odom belongs to
    the mapping layer (mapping_localization_pkg), which runs separately. Follows
    REP-105.
  </description>
  <maintainer email="upadhyp1@uci.edu">pran</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- Bring-up includes these workspace packages -->
  <exec_depend>helios_description</exec_depend>
  <exec_depend>wheel_odometry</exec_depend>
  <exec_depend>zed_wrapper</exec_depend>
  <!-- Sensor-specific config/launch live beside their own vendor submodules:
       custom_covariance and zed_custom_tuning in Camera/, custom_config in
       LiDAR/. Bring-up resolves all three by share path. urg_node2 itself is
       now custom_config's dependency, not ours. -->
  <exec_depend>custom_covariance</exec_depend>
  <exec_depend>zed_custom_tuning</exec_depend>
  <exec_depend>custom_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
