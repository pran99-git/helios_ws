build/
install/
log/

# Mapping run outputs (large binary .db/.pgm/.yaml, one per mapping run) --
# keep the folders tracked, not their contents.
src/mapping_localization_pkg/rtabmap/maps/*
!src/mapping_localization_pkg/rtabmap/maps/.gitkeep
src/mapping_localization_pkg/slam_toolbox/maps/*
!src/mapping_localization_pkg/slam_toolbox/maps/.gitkeep

# Python
__pycache__/
*.pyc

# Editor/OS
.vscode/
*.swp
.DS_Store

#CLAUDECODE RULES
CLAUDE.md

# VLA model weights and converted datasets (large binaries, never pushed)
models/*
!models/.gitkeep
datasets/*
!datasets/.gitkeep

# Python virtualenvs (machine-specific, absolute paths baked in).
# COLCON_IGNORE stays tracked: without it colcon indexes every setup.py
# under site-packages as a ROS package.
.venvs/*
!.venvs/COLCON_IGNORE

# Tool caches. These self-ignore today, but only because each tool writes its
# own .gitignore inside; list them so that does not have to hold.
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Debug and merge artifacts
frames.pdf
frames.gv
rosbag2_*/
*.orig
*.rej
